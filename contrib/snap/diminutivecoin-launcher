#!/bin/bash
# Run a Diminutivecoin binary against the standard ~/.diminutivecoin data
# directory rather than the snap's private HOME.
#
# A strictly confined snap gets HOME=$SNAP_USER_DATA, so the built-in default
# would land in ~/snap/diminutivecoin/current/.diminutivecoin. Rather than
# reassigning HOME - which would drag Qt's own config and cache along with it -
# the data directory is passed explicitly, leaving everything else where
# confinement puts it.
#
# Reaching the real path additionally needs the personal-files interface, which
# is not auto-connected. If it is missing, every access is denied by AppArmor,
# so check first and fall back rather than failing to start.

set -eu

bin="$1"
shift

real_home="${SNAP_REAL_HOME:-$HOME}"
datadir="$real_home/.diminutivecoin"

# An explicit -datadir always wins.
for arg in "$@"; do
    case "$arg" in
        -datadir=*|--datadir=*|-datadir|--datadir)
            exec "$SNAP/usr/bin/$bin" "$@"
            ;;
    esac
done

if mkdir -p "$datadir" 2>/dev/null && [ -w "$datadir" ]; then
    exec "$SNAP/usr/bin/$bin" -datadir="$datadir" "$@"
fi

cat >&2 <<EOF
diminutivecoin: cannot use $datadir
diminutivecoin: the personal-files interface is not connected. Connect it with
diminutivecoin:
diminutivecoin:     sudo snap connect diminutivecoin:dot-diminutivecoin
diminutivecoin:
diminutivecoin: falling back to the snap's private data directory at
diminutivecoin: $HOME/.diminutivecoin
EOF

exec "$SNAP/usr/bin/$bin" "$@"
